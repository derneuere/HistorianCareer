<?xml version="1.0" encoding="utf-8"?>
<!--
  L1 â€” Wissenschaftliche Hilfskraft (HiWi): "Transcribe Manuscript".
  Minimal one-shot interaction. The only loot is our custom HC_Loot_Add_HistorianLevel_Small
  which ticks our internal statistic. EA's basic_experience_pay_* / buff_Confidence_High
  references were fabricated in the v0.1 scaffold and don't resolve.

  interaction_category_tags â€” TunableSet of Tag enum values. Present on
  1,124 of 1,124 EA SuperInteractions per issue #14's audit, so likely
  required infrastructure even when no per-category gating is wired. We
  declare the minimum-broad SI tags here. If/when the per-instance
  pie-menu `category` field is wired (blocked on issue #15's 32-bit ID
  resolver; see Docs/NOTE_pie_menu_category_ids.md), having
  interaction_category_tags already in place is hypothesis #2 from the
  issue: that EA's pie-menu generator needs broad tags declared before
  the per-instance `category` field works.
-->
<I c="SuperInteraction" i="interaction" m="interactions.base.super_interaction" n="HC_Interaction_TranscribeManuscript" s="TBD_INSTANCE_ID">
  <!--
    Pie-menu submenu grouping (issue #14). References our PieMenuCategory
    tuning by name; the build resolves it to a 31-bit decimal instance ID
    via SMALL_ID_CLASSES → smallInstanceIdFor(). Previously reverted in
    commit 6a663ba because the Olympus UI silently rejected the category
    (no SimData companion to register it). Now restored — the build emits
    a paired SimData for HC_PieMenuCategory_Historian via the
    PIE_MENU_CATEGORY_SCHEMA in Build/simdata. See
    Docs/NOTE_pie_menu_category_registration.md for the full rationale.
  -->
  <T n="category">HC_PieMenuCategory_Historian</T>
  <T n="display_name">0xTBD_STBL_KEY_HC_INTERACTION_TRANSCRIBE_MANUSCRIPT</T>
  <L n="interaction_category_tags">
    <T>Interaction_Super</T>
    <T>Interaction_All</T>
  </L>
  <!--
    Timed activity (bug fix: was t="one_shot", which completed instantly). The
    Sim now sits at the computer and works for ~45-90 sim minutes before the
    outcome loot fires, matching the feel of EA's own computer tasks. Modelled
    on EA's computer_BlogAboutFeelings (s=24334): flexible_length with a
    time_based EXIT_NATURALLY, the generic Computer_* staging mixers, and the
    Computer_Use_Type canonical animation. All numeric refs are base-game.
  -->
  <V n="basic_content" t="flexible_length">
    <U n="flexible_length">
      <L n="conditional_actions">
        <V t="literal">
          <U n="literal">
            <L n="conditions">
              <V t="time_based">
                <U n="time_based">
                  <T n="max_time">90</T>
                  <T n="min_time">45</T>
                </U>
              </V>
            </L>
            <E n="interaction_action">EXIT_NATURALLY</E>
          </U>
        </V>
      </L>
      <V n="content" t="staging_content">
        <U n="staging_content">
          <U n="content_set">
            <L n="affordance_links">
              <T>99858</T><!-- Computer_Use_React -->
              <T>13197</T><!-- Computer_Chat_Keyboard -->
              <T>13199</T><!-- Computer_Chat_Mouse -->
              <T>10222</T><!-- Computer_Chat_Read -->
            </L>
          </U>
        </U>
      </V>
    </U>
  </V>
  <V n="canonical_animation" t="enabled">
    <U n="enabled">
      <T n="factory">31395</T><!-- Computer_Use_Type -->
    </U>
  </V>
  <V n="outcome" t="single">
    <U n="single">
      <U n="actions">
        <L n="loot_list">
          <T>HC_Loot_Add_HistorianLevel_Small</T>
        </L>
      </U>
    </U>
  </V>
</I>
