<?xml version="1.0" encoding="utf-8"?>
<!-- L1-L2 - Blogeintrag schreiben. Computer affordance (band gated in level_gate.py). -->
<I c="SuperInteraction" i="interaction" m="interactions.base.super_interaction" n="HC_Interaction_Blogeintrag" s="TBD_INSTANCE_ID">
  <T n="category">HC_PieMenuCategory_Historian</T>
  <T n="display_name">0xTBD_STBL_KEY_HC_INTERACTION_BLOGEINTRAG</T>
  <!-- See HC_Interaction_TranscribeManuscript.xml for the rationale on
       interaction_category_tags (issue #14 hypothesis 2). -->
  <L n="interaction_category_tags">
    <T>Interaction_Super</T>
    <T>Interaction_All</T>
  </L>
  <!--
    Timed activity (bug fix: was t="one_shot", which completed instantly). The
    Sim now sits at the computer and works for ~45-90 sim minutes before the
    outcome loot fires, matching the feel of EA's own computer tasks. Modelled
    on EA's computer_BlogAboutFeelings (s=24334): flexible_length with a
    time_based EXIT_NATURALLY, the generic Computer_* staging mixers, and the
    Computer_Use_Type canonical animation. All numeric refs are base-game.
  -->
  <V n="basic_content" t="flexible_length">
    <U n="flexible_length">
      <L n="conditional_actions">
        <V t="literal">
          <U n="literal">
            <L n="conditions">
              <V t="time_based">
                <U n="time_based">
                  <T n="max_time">90</T>
                  <T n="min_time">45</T>
                </U>
              </V>
            </L>
            <E n="interaction_action">EXIT_NATURALLY</E>
          </U>
        </V>
      </L>
      <V n="content" t="staging_content">
        <U n="staging_content">
          <U n="content_set">
            <L n="affordance_links">
              <T>99858</T><!-- Computer_Use_React -->
              <T>13197</T><!-- Computer_Chat_Keyboard -->
              <T>13199</T><!-- Computer_Chat_Mouse -->
              <T>10222</T><!-- Computer_Chat_Read -->
            </L>
          </U>
        </U>
      </V>
    </U>
  </V>
  <V n="canonical_animation" t="enabled">
    <U n="enabled">
      <T n="factory">31395</T><!-- Computer_Use_Type -->
    </U>
  </V>
  <V n="outcome" t="single">
    <U n="single">
      <U n="actions">
        <L n="loot_list">
          <T>HC_Loot_Add_HistorianLevel_Small</T>
        </L>
      </U>
    </U>
  </V>
</I>
