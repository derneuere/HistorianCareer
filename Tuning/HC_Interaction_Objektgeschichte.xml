<?xml version="1.0" encoding="utf-8"?>
<!-- L2 - Objektgeschichte recherchieren. Ships on the bookshelf surface
     (per DESIGN open-Q#2: no clean museum-exhibit object). Band gated in level_gate.py. -->
<!--
  Real read flow (was an instant one_shot; then a Stand_Idle loop). EA's read
  animation hard-binds a "book" ASM actor, so the Sim has to actually hold a
  book. This is now an ObjectInInventoryPickerInteraction modelled on EA's
  bookshelf_Read_Picker (s=39360): it lists the books stocked in the bookshelf
  (base-game shelves auto-stock ~11) and, on pick, pushes the
  HC_Interaction_ObjektgeschichteRead continuation onto the chosen book. That
  continuation plays EA's genuine read animation + carry for 45-90 sim minutes
  and fires the level loot.

  The pie-menu label, category, surface injection (affordance_injector.py) and
  rank gate (level_gate.py) all stay on THIS picker name, unchanged. The loot
  moved to the read continuation so career progress only fires after the Sim
  actually reads. All numeric refs are base-game.
-->
<I c="ObjectInInventoryPickerInteraction" i="interaction" m="interactions.base.picker_interaction" n="HC_Interaction_Objektgeschichte" s="TBD_INSTANCE_ID">
  <T n="category">HC_PieMenuCategory_Historian</T>
  <T n="display_name">0xTBD_STBL_KEY_HC_INTERACTION_OBJEKTGESCHICHTE</T>
  <!-- See HC_Interaction_TranscribeManuscript.xml for the rationale on
       interaction_category_tags (issue #14 hypothesis 2). -->
  <L n="interaction_category_tags">
    <T>Interaction_Super</T>
    <T>Interaction_All</T>
  </L>
  <V n="_saveable" t="disabled"/>
  <V n="continuation" t="enabled">
    <L n="enabled">
      <U>
        <T n="affordance">HC_Interaction_ObjektgeschichteRead</T>
        <E n="target">PickedObject</E>
      </U>
    </L>
  </V>
  <V n="inventory_item_test" t="tag_set">
    <U n="tag_set">
      <L n="tag_set">
        <E>BuyCatEE_MiscKids</E>
        <E>Func_Book_BookOfLife</E>
      </L>
      <E n="test_type">CONTAINS_NO_TAGS_IN_SET</E>
    </U>
  </V>
  <E n="inventory_subject">Object</E>
  <V n="picker_dialog" t="object_picker">
    <U n="object_picker">
      <T n="hide_row_description">True</T>
      <T n="is_sortable">True</T>
      <E n="picker_type">OBJECT</E>
    </U>
  </V>
  <T n="single_push_continuation">True</T>
  <E n="target_type">OBJECT</E>
</I>
