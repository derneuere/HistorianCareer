<?xml version="1.0" encoding="utf-8"?>
<!--
  Field names per EA Objective TDESC; see objective_HC_ReadNonfictionBook.xml for notes.
-->
<I c="Objective" i="objective" m="event_testing.objective_tuning" n="objective_HC_RunObjektgeschichte" s="TBD_INSTANCE_ID">
  <T n="display_text">0xTBD_STBL_KEY_HC_OBJ_OBJEKT</T>
  <V n="objective_completion_type" t="iterations">
    <U n="iterations">
      <T n="iterations_required_to_pass">1</T>
    </U>
  </V>
  <V n="objective_test" t="ran_interaction_test">
    <U n="ran_interaction_test">
      <!-- Match either the bookshelf picker or its read continuation: depending
           on whether the picker itself raises the interaction event, the read SI
           (HC_Interaction_ObjektgeschichteRead) is the reliable signal. -->
      <L n="affordances">
        <T>HC_Interaction_Objektgeschichte</T>
        <T>HC_Interaction_ObjektgeschichteRead</T>
      </L>
    </U>
  </V>
</I>
