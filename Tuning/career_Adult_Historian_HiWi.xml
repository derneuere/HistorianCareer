<?xml version="1.0" encoding="utf-8"?>
<!--
  Historian career — HiWi fast-track entry (bug fix: "in the Job suchen dialog
  the option to start at Level 5 is missing as a separate entry from the regular
  job").

  This is a SECOND Career resource so the find-a-job picker shows a distinct
  second row ("Historian (Research Assistant)") alongside the regular Historian
  job. It is identical to career_Adult_Historian.xml EXCEPT:

    1. start_track -> career_track_Adult_Historian_HiWi (its own display name).
    2. career_availablity_tests gains a History-degree trait requirement (230331,
       Discover University) so the entry ONLY appears for degree holders — the
       README design. On a base-game install (no DU, no trait) the entry simply
       does not appear, which is expected.
    3. start_level_modifiers is an UNCONDITIONAL +4, so joining this entry always
       begins at user_level 5 (Wissenschaftliche Hilfskraft / HiWi). The regular
       career_Adult_Historian entry always starts at L1 for everyone.

  Everything else (block_promotion_tests, career_affordance, career_messages,
  career_location, days_to_level_loss, go_home_to_work_affordance, category)
  mirrors career_Adult_Historian.xml so the two entries share identical gameplay
  above the entry point. The ten CareerLevels are shared between both tracks.
-->
<I c="Career" i="career" m="careers.career_tuning" n="career_Adult_Historian_HiWi" s="TBD_INSTANCE_ID">
  <!--
    Skill gates on promotion — identical to career_Adult_Historian. These are
    keyed by the shared CareerLevel tunings, so the same gates apply when a HiWi
    Sim promotes (L6->L7, L7->L8, L8->L9, L9->L10). The L1->L2 gate never
    triggers here because this entry starts above L1.
  -->
  <L n="block_promotion_tests">
    <!-- L1->L2: Writing >= 2 (block while Writing <= 1 at L1). -->
    <L>
      <V t="career_test">
        <U n="career_test">
          <V n="test_type" t="career_level">
            <U n="career_level">
              <T n="career_level">career_level_Adult_Historian_L1</T>
            </U>
          </V>
        </U>
      </V>
      <V t="skill_test">
        <U n="skill_test">
          <T n="skill">16714</T>
          <V n="skill_range" t="interval">
            <U n="interval">
              <U n="skill_interval">
                <T n="upper_bound">1</T>
              </U>
            </U>
          </V>
        </U>
      </V>
    </L>
    <!-- L1->L2: Charisma >= 1 (block while Charisma <= 0 at L1). -->
    <L>
      <V t="career_test">
        <U n="career_test">
          <V n="test_type" t="career_level">
            <U n="career_level">
              <T n="career_level">career_level_Adult_Historian_L1</T>
            </U>
          </V>
        </U>
      </V>
      <V t="skill_test">
        <U n="skill_test">
          <T n="skill">16699</T>
          <V n="skill_range" t="interval">
            <U n="interval">
              <U n="skill_interval">
                <T n="upper_bound">0</T>
              </U>
            </U>
          </V>
        </U>
      </V>
    </L>
    <!-- L6->L7: Research & Debate >= 7 (block while R&D <= 6 at L6). -->
    <L>
      <V t="career_test">
        <U n="career_test">
          <V n="test_type" t="career_level">
            <U n="career_level">
              <T n="career_level">career_level_Adult_Historian_L6</T>
            </U>
          </V>
        </U>
      </V>
      <V t="skill_test">
        <U n="skill_test">
          <T n="skill">221014</T>
          <V n="skill_range" t="interval">
            <U n="interval">
              <U n="skill_interval">
                <T n="upper_bound">6</T>
              </U>
            </U>
          </V>
        </U>
      </V>
    </L>
    <!-- L7->L8: Writing >= 7 (block while Writing <= 6 at L7). -->
    <L>
      <V t="career_test">
        <U n="career_test">
          <V n="test_type" t="career_level">
            <U n="career_level">
              <T n="career_level">career_level_Adult_Historian_L7</T>
            </U>
          </V>
        </U>
      </V>
      <V t="skill_test">
        <U n="skill_test">
          <T n="skill">16714</T>
          <V n="skill_range" t="interval">
            <U n="interval">
              <U n="skill_interval">
                <T n="upper_bound">6</T>
              </U>
            </U>
          </V>
        </U>
      </V>
    </L>
    <!-- L8->L9 Habilitation: Research & Debate = 10 (block while R&D <= 9 at L8). -->
    <L>
      <V t="career_test">
        <U n="career_test">
          <V n="test_type" t="career_level">
            <U n="career_level">
              <T n="career_level">career_level_Adult_Historian_L8</T>
            </U>
          </V>
        </U>
      </V>
      <V t="skill_test">
        <U n="skill_test">
          <T n="skill">221014</T>
          <V n="skill_range" t="interval">
            <U n="interval">
              <U n="skill_interval">
                <T n="upper_bound">9</T>
              </U>
            </U>
          </V>
        </U>
      </V>
    </L>
    <!-- L8->L9 Habilitation: Writing = 10 (block while Writing <= 9 at L8). -->
    <L>
      <V t="career_test">
        <U n="career_test">
          <V n="test_type" t="career_level">
            <U n="career_level">
              <T n="career_level">career_level_Adult_Historian_L8</T>
            </U>
          </V>
        </U>
      </V>
      <V t="skill_test">
        <U n="skill_test">
          <T n="skill">16714</T>
          <V n="skill_range" t="interval">
            <U n="interval">
              <U n="skill_interval">
                <T n="upper_bound">9</T>
              </U>
            </U>
          </V>
        </U>
      </V>
    </L>
    <!-- L9->L10: Charisma >= 5 (block while Charisma <= 4 at L9). -->
    <L>
      <V t="career_test">
        <U n="career_test">
          <V n="test_type" t="career_level">
            <U n="career_level">
              <T n="career_level">career_level_Adult_Historian_L9</T>
            </U>
          </V>
        </U>
      </V>
      <V t="skill_test">
        <U n="skill_test">
          <T n="skill">16699</T>
          <V n="skill_range" t="interval">
            <U n="interval">
              <U n="skill_interval">
                <T n="upper_bound">4</T>
              </U>
            </U>
          </V>
        </U>
      </V>
    </L>
  </L>

  <!-- 29941: EA career_GoToWork_Writer SI — thematically closest stand-in. -->
  <T n="career_affordance">29941</T>

  <!--
    Availability: young-adult+ AND the History-degree trait (230331). The trait
    group is what makes this a degree-GATED separate entry: only Sims who hold
    the Discover University History degree see it in the find-a-job picker. On a
    base-game install the trait does not exist, so the test never passes and the
    entry stays hidden (expected). Outer list is OR of groups; each inner <L> is
    AND of its tests — here both groups must hold (age + trait).
  -->
  <L n="career_availablity_tests">
    <L>
      <V t="sim_info">
        <U n="sim_info">
          <V n="ages" t="specified">
            <L n="specified">
              <E>YOUNGADULT</E>
              <E>ADULT</E>
              <E>ELDER</E>
            </L>
          </V>
        </U>
      </V>
    </L>
    <L>
      <V t="trait">
        <U n="trait">
          <L n="whitelist_traits">
            <T>230331</T>
          </L>
        </U>
      </V>
    </L>
  </L>

  <E n="career_category">Work</E>

  <!-- Career messages mirror career_Adult_Historian exactly. -->
  <U n="career_messages">
    <V n="career_assignment_summary_notification" t="tested">
      <U n="tested">
        <L n="records">
          <U>
            <U n="item">
              <V n="text" t="single">
                <T n="single">0xTBD_STBL_KEY_HC_CAREER_WFH_SUMMARY</T>
              </V>
            </U>
            <L n="tests"/>
          </U>
        </L>
      </U>
    </V>
    <V n="career_daily_end_notification" t="tested">
      <U n="tested">
        <L n="records">
          <U>
            <U n="item">
              <V n="text" t="single">
                <T n="single">0xTBD_STBL_KEY_HC_CAREER_DAILY_END_HIGH_PERF</T>
              </V>
            </U>
            <L n="tests">
              <L>
                <V t="statistic">
                  <U n="statistic">
                    <T n="stat">HC_PerformanceStat_Historian</T>
                    <V n="threshold" t="value_threshold">
                      <U n="value_threshold">
                        <E n="comparison">GREATER_OR_EQUAL</E>
                        <T n="value">60</T>
                      </U>
                    </V>
                  </U>
                </V>
              </L>
            </L>
          </U>
          <U>
            <U n="item">
              <V n="text" t="single">
                <T n="single">0xTBD_STBL_KEY_HC_CAREER_DAILY_END_LOW_PERF</T>
              </V>
            </U>
            <L n="tests"/>
          </U>
        </L>
      </U>
    </V>
    <U n="career_daily_start_notification">
      <V n="text" t="single">
        <T n="single">0xTBD_STBL_KEY_HC_CAREER_DAILY_START</T>
      </V>
    </U>
    <V n="career_early_warning_alarm" t="enabled">
      <U n="enabled">
        <T n="call_in_sick_text">0x9291A330</T>
        <U n="dialog">
          <V n="text" t="single">
            <T n="single">0xCF6C9354</T>
          </V>
          <V n="timeout_duration" t="enabled">
            <T n="enabled">55</T>
          </V>
        </U>
        <T n="go_to_work_text">0x55B02A1F</T>
        <T n="take_pto_text">0x17539AB0</T>
        <T n="work_from_home_text">0xTBD_STBL_KEY_HC_CAREER_WFH_TEXT</T>
      </U>
    </V>
    <U n="career_early_warning_notification">
      <V n="text" t="single">
        <T n="single">0xTBD_STBL_KEY_HC_CAREER_EARLY_WARNING</T>
      </V>
    </U>
    <V n="career_missing_work" t="enabled">
      <U n="enabled">
        <T n="affordance">77302</T>
        <U n="dialog">
          <V n="icon" t="enabled">
            <V n="enabled" t="resource_key">
              <U n="resource_key">
                <T n="key" p="InGame\UI\Icons\Headlines\Final\headline_careersimoleons.png">2f7d0004:00000000:617140672fa22f7b</T>
              </U>
            </V>
          </V>
          <E n="phone_ring_type">RING</E>
          <V n="text" t="single">
            <T n="single">0xTBD_STBL_KEY_HC_CAREER_MISSING_WORK_NOTIFICATION</T>
          </V>
          <V n="title" t="enabled">
            <T n="enabled">0xTBD_STBL_KEY_HC_CAREER_NAME</T>
          </V>
        </U>
      </U>
    </V>
    <U n="career_performance_warning">
      <T n="affordance">77301</T>
      <U n="dialog">
        <V n="icon" t="enabled">
          <V n="enabled" t="resource_key">
            <U n="resource_key">
              <T n="key" p="InGame\UI\Icons\Headlines\Final\headline_careersimoleons.png">2f7d0004:00000000:617140672fa22f7b</T>
            </U>
          </V>
        </V>
        <E n="phone_ring_type">RING</E>
        <V n="text" t="single">
          <T n="single">0xTBD_STBL_KEY_HC_CAREER_PERFORMANCE_WARNING</T>
        </V>
        <V n="title" t="enabled">
          <T n="enabled">0xTBD_STBL_KEY_HC_CAREER_NAME</T>
        </V>
      </U>
      <U n="threshold">
        <E n="comparison">LESS_OR_EQUAL</E>
        <T n="value">-50</T>
      </U>
    </U>
    <U n="demote_career_notification">
      <V n="text" t="single">
        <T n="single">0x89568E38</T>
      </V>
      <V n="title" t="enabled">
        <T n="enabled">0xA13D761D</T>
      </V>
    </U>
    <U n="fire_career_notification">
      <V n="text" t="single">
        <T n="single">0xTBD_STBL_KEY_HC_CAREER_FIRE_NOTIFICATION</T>
      </V>
      <V n="title" t="enabled">
        <T n="enabled">0x1FD4456D</T>
      </V>
    </U>
    <V n="join_career_notification" t="enabled">
      <U n="enabled">
        <V n="text" t="single">
          <T n="single">0xTBD_STBL_KEY_HC_CAREER_JOIN_NOTIFICATION</T>
        </V>
        <V n="title" t="enabled">
          <T n="enabled">0xTBD_STBL_KEY_HC_CAREER_HIWI_NAME</T>
        </V>
      </U>
    </V>
    <U n="overmax_notification">
      <V n="text" t="single">
        <T n="single">0xTBD_STBL_KEY_HC_CAREER_OVERMAX_NOTIFICATION</T>
      </V>
      <V n="title" t="enabled">
        <T n="enabled">0xTBD_STBL_KEY_HC_CAREER_OVERMAX_TITLE</T>
      </V>
    </U>
    <U n="overmax_rewardless_notification">
      <V n="text" t="single">
        <T n="single">0xTBD_STBL_KEY_HC_CAREER_OVERMAX_NOTIFICATION</T>
      </V>
      <V n="title" t="enabled">
        <T n="enabled">0xTBD_STBL_KEY_HC_CAREER_OVERMAX_TITLE</T>
      </V>
    </U>
    <U n="promote_career_notification">
      <V n="text" t="single">
        <T n="single">0xTBD_STBL_KEY_HC_CAREER_PROMOTE_NOTIFICATION</T>
      </V>
      <V n="title" t="enabled">
        <T n="enabled">0x54E0293D</T>
      </V>
    </U>
    <U n="promote_career_rewardless_notification">
      <V n="text" t="single">
        <T n="single">0xTBD_STBL_KEY_HC_CAREER_PROMOTE_NOTIFICATION</T>
      </V>
      <V n="title" t="enabled">
        <T n="enabled">0x54E0293D</T>
      </V>
    </U>
    <U n="quit_career_notification">
      <V n="text" t="single">
        <T n="single">0xC55953D2</T>
      </V>
      <V n="title" t="enabled">
        <T n="enabled">0xAE185370</T>
      </V>
    </U>
  </U>

  <!-- Same employers as the regular Historian career. -->
  <V n="career_location" t="company">
    <U n="company">
      <L n="company_names">
        <T>0xTBD_STBL_KEY_HC_COMPANY_UNIVERSITAET_BERLIN</T>
        <T>0xTBD_STBL_KEY_HC_COMPANY_PREUSSISCHER_KULTURBESITZ</T>
        <T>0xTBD_STBL_KEY_HC_COMPANY_BUNDESARCHIV</T>
        <T>0xTBD_STBL_KEY_HC_COMPANY_HUMBOLDT_INSTITUT</T>
        <T>0xTBD_STBL_KEY_HC_COMPANY_LEIBNIZ_GESELLSCHAFT</T>
      </L>
    </U>
  </V>

  <T n="days_to_level_loss">2</T>

  <!-- 98770: universal `career_GoHomeFromWork`. -->
  <T n="go_home_to_work_affordance">98770</T>

  <T n="levels_lost_on_leave">0</T>

  <!--
    Unconditional +4 start: base start level is 1; this entry always adds 4 so a
    Sim joining the HiWi track begins directly at L5 (Wissenschaftliche
    Hilfskraft). No trait test inside the modifier is needed because the entry
    is already degree-gated by career_availablity_tests above — every Sim who can
    see/join it holds the History degree by definition.
  -->
  <U n="start_level_modifiers">
    <L n="modifiers">
      <U>
        <T n="modifier">4</T>
        <L n="tests"/>
      </U>
    </L>
  </U>

  <T n="start_track">career_track_Adult_Historian_HiWi</T>
</I>
