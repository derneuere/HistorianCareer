  <T n="display_name">0xTBD_STBL_KEY_HC_INTERACTION_ZEITZEUGEN</T>
  <L n="interaction_category_tags">
    <T>Interaction_SocialSuper</T>
    <T>Interaction_Super</T>
    <T>Interaction_All</T>
  </L>
  <E n="target_type">TARGET</E>
  <L n="test_globals">
    <V t="sim_info">
      <U n="sim_info">
        <V n="ages" t="specified">
          <L n="specified">
            <E>ELDER</E>
          </L>
        </V>
        <E n="who">TargetSim</E>
      </U>
    </V>
  </L>
  <V n="basic_content" t="one_shot"/>
  <V n="outcome" t="single">
    <U n="single">
      <U n="actions">
        <L n="loot_list">
          <T>HC_Loot_Add_HistorianLevel_Small</T>
        </L>
      </U>
    </U>
  </V>
</I>
